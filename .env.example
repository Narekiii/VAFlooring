# Optional. Defaults to https://www.vaflooring.la, so sitemap.xml, canonical URLs and
# indexing work with no setup. Set only to use a different domain. Vercel preview
# deployments are never indexed.
NEXT_PUBLIC_SITE_URL=

# Optional: search-engine ownership verification codes (content value of the meta tag only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---- Estimate and contact form delivery (configure at least one) -------------
# Both the estimate form (/api/estimate) and the contact form (/api/contact) use these.
# Option A: forward each request as JSON to an HTTPS endpoint
# (Zapier/Make webhook, CRM intake URL, Formspree endpoint, etc.)
ESTIMATE_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header
ESTIMATE_WEBHOOK_SECRET=

# Option B: email each request through Resend (https://resend.com)
RESEND_API_KEY=
# One or more recipients, comma-separated
ESTIMATE_EMAIL_TO=
# Sender on a domain verified in Resend, e.g. "V & A Flooring Website <estimates@yourdomain.com>"
ESTIMATE_EMAIL_FROM=
