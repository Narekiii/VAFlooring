# Copy to .env.local for local development, and add the same names in Vercel:
# Project → Settings → Environment Variables. Never commit real values.

# Password for the single administrator account (username: admin). Use a long, unique password.
CRM_ADMIN_PASSWORD=

# Secret used to sign login sessions: at least 32 random characters. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# PostgreSQL connection string, e.g. from Neon (free): postgres://user:password@host/db?sslmode=require
# Leave empty for local development: the app then uses an embedded database stored in ./.data
DATABASE_URL=
