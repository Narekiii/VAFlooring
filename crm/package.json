{
  "name": "va-flooring-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Internal CRM for V & A Flooring Inc (crm.vaflooring.la).",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:add": "tsx scripts/add-user.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "next": "^16.4.3",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
